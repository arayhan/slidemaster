# Normalize all text files to LF in the repo and on checkout.
# Kills the "LF will be replaced by CRLF" warnings caused by core.autocrlf=true.
* text=auto eol=lf

# Explicit text types (redundant with text=auto, but documents intent)
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
*.toml text eol=lf
*.env  text eol=lf

# Binary — never touch line endings, never diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.sqlite binary
